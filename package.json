{
  "name": "aurameme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AuraMeme — Solana/pump.fun memecoin safety analysis & signal bot (Telegram + web dashboard).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "serve": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "scan": "tsx src/scripts/scan.ts",
    "backtest": "tsx src/backtest/run.ts",
    "sweep": "tsx src/backtest/sweep.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fetch-socks": "^1.3.3",
    "grammy": "^1.30.0",
    "https-proxy-agent": "^9.1.0",
    "socks-proxy-agent": "^10.1.0",
    "undici": "^8.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
