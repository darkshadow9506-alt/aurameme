# ===========================================================================
# AuraMeme — configuration
# Copy this file to `.env` and fill in your values.  Never commit `.env`.
# ===========================================================================

# --- Telegram ---------------------------------------------------------------
# Create a bot via @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# Your numeric chat id (message @userinfobot to get it). Signals are pushed here.
# Comma-separate for multiple recipients. Leave empty to disable push (commands still work).
TELEGRAM_CHAT_IDS=

# --- Solana RPC -------------------------------------------------------------
# The public endpoint is heavily rate-limited. For real use get a free key from
# Helius (helius.dev) or QuickNode and put the full URL here.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Data sources -----------------------------------------------------------
# PumpPortal public realtime feed (free). Usually no key needed.
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
DEXSCREENER_BASE=https://api.dexscreener.com

# --- Web dashboard ----------------------------------------------------------
WEB_PORT=8787
# Bind to 0.0.0.0 if you run on a VPS and want to reach it remotely.
WEB_HOST=127.0.0.1

# --- Engine tuning ----------------------------------------------------------
# Minimum overall score (0-100) required before a token is pushed to Telegram.
SIGNAL_MIN_SCORE=70
# Minimum on-chain liquidity (USD) for a token to even be considered.
MIN_LIQUIDITY_USD=4000
# How many of the top holders to inspect for concentration.
TOP_HOLDERS_CHECK=20
# Comma-separated smart-money wallets to always watch (optional seed list).
SMART_MONEY_WALLETS=

# --- Safety -----------------------------------------------------------------
# Set to 1 only if you understand the risk. This NEVER auto-trades; it only alerts.
DRY_RUN=1
