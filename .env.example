# ===========================================================================
# AuraMeme — configuration
# Copy this file to `.env` and fill in your values.  Never commit `.env`.
# ===========================================================================

# --- Telegram ---------------------------------------------------------------
# Create a bot via @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# Your numeric chat id (message @userinfobot to get it). Signals are pushed here.
# Comma-separate for multiple recipients. Leave empty to disable push (commands still work).
TELEGRAM_CHAT_IDS=

# --- Proxy (run on your OWN machine inside Iran) ----------------------------
# The data APIs sanction-block Iranian IPs. To run locally, route the bot
# through a proxy/VPN endpoint (only the bot's traffic, not your whole PC).
# Examples:
#   PROXY_URL=http://127.0.0.1:8080      (V2Ray/most clients' HTTP inbound)
#   PROXY_URL=socks5://127.0.0.1:1080    (Shadowsocks / V2Ray SOCKS)
# Leave empty if you run on a VPS outside Iran.
PROXY_URL=

# --- Solana RPC -------------------------------------------------------------
# The public endpoint is heavily rate-limited. For real use get a free key from
# Helius (helius.dev) or QuickNode and put the full URL here.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Data sources -----------------------------------------------------------
# Realtime feed source:
#   pumpportal = pump.fun's own websocket (default, simplest)
#   solana     = decode pump.fun program logs straight off the Solana RPC
#                websocket. Use this if pumpportal.fun is BLOCKED from your VPN
#                exit (ETIMEDOUT) but your RPC (Helius strongly recommended) is
#                reachable. Set HELIUS_API_KEY / SOLANA_RPC_URL below.
FEED_SOURCE=pumpportal

# PumpPortal public realtime feed (free). Usually no key needed.
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
DEXSCREENER_BASE=https://api.dexscreener.com

# --- Indexers (optional, but strongly recommended) --------------------------
# Helius (helius.dev, free tier) unlocks the TRUE holder count, LP-excluded
# concentration, and SOL-funder clustering for deep bundle detection.
# A Helius key here is also a great value for SOLANA_RPC_URL above:
#   https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_API_KEY=
# Birdeye (birdeye.so, free tier) is used as a holder-data fallback / cross-check.
BIRDEYE_API_KEY=

# --- Web dashboard ----------------------------------------------------------
WEB_PORT=8787
# Bind to 0.0.0.0 if you run on a VPS and want to reach it remotely.
WEB_HOST=127.0.0.1

# --- Engine tuning ----------------------------------------------------------
# Minimum overall score (0-100) required before a token is pushed to Telegram.
SIGNAL_MIN_SCORE=70
# Minimum on-chain liquidity (USD) for a token to even be considered.
MIN_LIQUIDITY_USD=4000
# How many of the top holders to inspect for concentration.
TOP_HOLDERS_CHECK=20
# Comma-separated smart-money wallets to always watch (optional seed list).
SMART_MONEY_WALLETS=
# Max simultaneous outbound API requests. Lower this if you see "fetch failed"
# on a free RPC tier or a slow VPN; raise it on a paid RPC for faster grading.
MAX_CONCURRENT_REQUESTS=5
# Max tokens analyzed at once. Under a burst, extra launches are dropped instead
# of piling up. Lower on a constrained machine; raise on a beefy box + paid RPC.
MAX_GRADING_INFLIGHT=25
# Deep bundle detection via SOL-funder clustering is accurate but costs many RPC
# calls per token — keep off on a free RPC tier; turn on ("1") with a paid RPC.
ENABLE_FUNDER_CLUSTER=0
# Auto-discovery: a wallet that round-trips a tracked token for at least this
# much realized profit (SOL) gets promoted to the smart-money table and watched.
DISCOVERY_MIN_PROFIT_SOL=1
# Cap on how many wallets we subscribe to (websocket budget).
MAX_WATCHED_WALLETS=300

# --- Live entry/exit alerts -------------------------------------------------
# A single buy this big (SOL) = "whale buy" -> fires an ENTRY alert.
# Raise it (e.g. 5) for fewer/higher-conviction alerts; lower it for more.
WHALE_BUY_SOL=3
# A single sell this big (SOL) = "whale dump" -> fires an EXIT warning.
WHALE_SELL_SOL=3
# Max tokens tracked live at once (websocket budget).
TRACK_MAX_TOKENS=150
# Stop tracking a token after this many minutes.
TRACK_TTL_MIN=45
# Sudden market-cap drop (%) in a short window that triggers a dump EXIT.
EXIT_DUMP_PCT=30

# --- Strategy profile -------------------------------------------------------
# How aggressively to take profit vs let winners run:
#   conservative | balanced | aggressive | moon
# Default "moon" = most total profit in the backtest sweep (lower win-rate,
# fattest winners). Run `npm run sweep` to compare, then pick what suits you.
STRATEGY_PROFILE=moon

# --- Safety -----------------------------------------------------------------
# Set to 1 only if you understand the risk. This NEVER auto-trades; it only alerts.
DRY_RUN=1
